{
  "$schema": "https://ferrflow.com/schema/ferrflow.json",
  "workspace": {
    "versioning": "zerover",
    "tagTemplate": "v{version}",
    "hooks": {
      "postBump": "cargo update -p lfsx-server"
    }
  },
  "package": [
    {
      "name": "lfsx-server",
      "path": ".",
      "changelog": "CHANGELOG.md",
      "versionedFiles": [
        { "path": "server/Cargo.toml", "format": "toml" }
      ]
    }
  ]
}
