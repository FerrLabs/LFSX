{
  "$schema": "https://ferrflow.com/schema/ferrflow.json",
  "workspace": {
    "versioning": "semver",
    "tagTemplate": "v{version}"
  },
  "package": [
    {
      "name": "lfsx-server",
      "path": "server",
      "changelog": "CHANGELOG.md",
      "versionedFiles": [
        {
          "path": "server/Cargo.toml",
          "format": "toml"
        },
        {
          "path": "cli/Cargo.toml",
          "format": "toml"
        },
        {
          "path": "cli/npm/package.json",
          "format": "json"
        },
        {
          "path": "cli/npm/platforms/linux-x64/package.json",
          "format": "json"
        },
        {
          "path": "cli/npm/platforms/linux-arm64/package.json",
          "format": "json"
        },
        {
          "path": "cli/npm/platforms/darwin-x64/package.json",
          "format": "json"
        },
        {
          "path": "cli/npm/platforms/darwin-arm64/package.json",
          "format": "json"
        },
        {
          "path": "cli/npm/platforms/win32-x64/package.json",
          "format": "json"
        },
        {
          "path": "chart/Chart.yaml",
          "format": "chartyaml"
        },
        {
          "path": "chart/Chart.yaml",
          "format": "txt",
          "selector": "(?m)^appVersion: \"([^\"]+)\""
        },
        {
          "path": "chart/Chart.yaml",
          "format": "txt",
          "selector": "(?m)^      image: ghcr\\.io/ferrlabs/lfsx:(.+)$"
        }
      ],
      "sharedPaths": [
        "cli",
        "bench",
        "chart",
        "ci",
        "Cargo.toml",
        "Cargo.lock",
        "Dockerfile",
        "rust-toolchain.toml"
      ],
      "hooks": {
        "postBump": "cargo update -p lfsx-server -p lfsx"
      }
    },
    {
      "name": "site",
      "path": "site",
      "sharedPaths": [
        "docs"
      ],
      "versioning": "calver",
      "tagTemplate": "site-v{version}",
      "changelog": "site/CHANGELOG.md",
      "versionedFiles": [
        {
          "path": "site/package.json",
          "format": "json"
        }
      ]
    }
  ]
}
