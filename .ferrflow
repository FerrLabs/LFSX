{
  "$schema": "https://ferrflow.com/schema/ferrflow.json",
  "workspace": {
    "versioning": "calver-seq",
    "tagTemplate": "v{version}",
    "updateLockfiles": true
  },
  "package": [
    {
      "name": "lfsx-server",
      "path": ".",
      "changelog": "CHANGELOG.md",
      "versionedFiles": [
        { "path": "server/Cargo.toml", "format": "toml" }
      ]
    }
  ]
}
